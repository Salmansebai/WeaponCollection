<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WeaponCollection.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="WeaponCollection.Views.CollectionDetailsView"
             x:DataType="vm:CollectionDetailsViewModel">

    <Grid Background="#0f0f0f">

        <!-- Contenu principal -->
        <ScrollViewer Padding="30" IsVisible="{Binding !ShowConfirmDelete}">
            <StackPanel Spacing="20" MaxWidth="900" HorizontalAlignment="Center">

                <!-- Boutons Back + Edit + Delete -->
                <Grid ColumnDefinitions="*,Auto">
                    <Button Grid.Column="0" Command="{Binding BackCommand}" HorizontalAlignment="Left">
                        <Button.Template>
                            <ControlTemplate>
                                <Border Background="#1a1a1a" CornerRadius="8" Padding="14,8"
                                        BorderBrush="#2a2a2a" BorderThickness="1">
                                    <TextBlock Text="← Back" Foreground="#aaa" FontSize="13"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                        <Button Command="{Binding EditCommand}" CommandParameter="{Binding MyWeapon.Id}">
                            <Button.Template>
                                <ControlTemplate>
                                    <Border Background="#1e3a5f" CornerRadius="8" Padding="14,8"
                                            BorderBrush="#2a5a8f" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="✏" Foreground="#3498db" FontSize="13"/>
                                            <TextBlock Text="Edit" Foreground="#3498db" FontSize="13" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Command="{Binding ShowDeleteConfirmCommand}">
                            <Button.Template>
                                <ControlTemplate>
                                    <Border Background="#3a1a1a" CornerRadius="8" Padding="14,8"
                                            BorderBrush="#5a2a2a" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="🗑" Foreground="#e74c3c" FontSize="13"/>
                                            <TextBlock Text="Delete" Foreground="#e74c3c" FontSize="13" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Carte principale -->
                <Border Background="#1a1a1a" CornerRadius="16" BorderBrush="#2a2a2a" BorderThickness="1">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Grid.Column="0" Background="#111" CornerRadius="16,0,0,16"
                                Width="280" ClipToBounds="True">
                            <Image Source="{Binding MyWeapon.Picture}" Stretch="Uniform" Margin="20"/>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="24,20" Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Background="#c0392b" CornerRadius="4" Padding="8,3">
                                    <TextBlock Text="{Binding MyWeapon.Type}" FontSize="11"
                                               FontWeight="Bold" Foreground="White" LetterSpacing="1"/>
                                </Border>
                                <Border Background="#1e3a5f" CornerRadius="4" Padding="8,3"
                                        IsVisible="{Binding MyWeapon.Era, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <TextBlock Text="{Binding MyWeapon.Era}" FontSize="11"
                                               FontWeight="Bold" Foreground="#3498db" LetterSpacing="1"/>
                                </Border>
                                <Border Background="#1a3a1a" CornerRadius="4" Padding="8,3"
                                        IsVisible="{Binding MyWeapon.Country, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <TextBlock Text="{Binding MyWeapon.Country}" FontSize="11"
                                               FontWeight="Bold" Foreground="#2ecc71" LetterSpacing="1"/>
                                </Border>
                            </StackPanel>

                            <TextBlock Text="{Binding MyWeapon.Name}" FontSize="28"
                                       FontWeight="Bold" Foreground="White"/>
                            <Border Background="#2a2a2a" Height="1"/>

                            <StackPanel Orientation="Horizontal" Spacing="24" Margin="0,4,0,0">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="DAMAGE" FontSize="9" Foreground="#555" LetterSpacing="2"/>
                                    <TextBlock Text="{Binding MyWeapon.Damage}" FontSize="18"
                                               FontWeight="Bold" Foreground="#e74c3c"/>
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="WEIGHT" FontSize="9" Foreground="#555" LetterSpacing="2"/>
                                    <TextBlock Text="{Binding MyWeapon.Weight, StringFormat='{}{0} kg'}"
                                               FontSize="18" FontWeight="Bold" Foreground="#3498db"/>
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="PRICE" FontSize="9" Foreground="#555" LetterSpacing="2"/>
                                    <TextBlock Text="{Binding MyWeapon.Price, StringFormat='{}{0} €'}"
                                               FontSize="18" FontWeight="Bold" Foreground="#2ecc71"/>
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="CATEGORY" FontSize="9" Foreground="#555" LetterSpacing="2"/>
                                    <TextBlock Text="{Binding MyWeapon.Type}" FontSize="14"
                                               FontWeight="Bold" Foreground="#f39c12"/>
                                </StackPanel>
                            </StackPanel>

                            <Border Background="#2a2a2a" Height="1"/>

                            <StackPanel Spacing="8"
                                        IsVisible="{Binding MyWeapon.Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Text="DESCRIPTION" FontSize="9" Foreground="#555" LetterSpacing="2"/>
                                <TextBlock Text="{Binding MyWeapon.Description}" FontSize="13"
                                           Foreground="#aaa" TextWrapping="Wrap" LineHeight="20"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Popup confirmation Delete -->
        <Grid IsVisible="{Binding ShowConfirmDelete}"
              Background="#CC000000"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
            <Border Background="#141414"
                    CornerRadius="24"
                    BorderBrush="#2a2a2a"
                    BorderThickness="1"
                    MaxWidth="380"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>

                    <!-- Header rouge -->
                    <Border Background="#c0392b"
                            CornerRadius="24,24,0,0"
                            Padding="32,28">
                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                            <TextBlock Text="🗑" FontSize="36" HorizontalAlignment="Center"/>
                            <TextBlock Text="Supprimer cette arme ?"
                                       FontSize="17" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Spacing="20" Margin="28,24,28,28">

                        <!-- Nom arme -->
                        <Border Background="#1e1e1e" CornerRadius="12" Padding="16,12"
                                BorderBrush="#333" BorderThickness="1">
                            <TextBlock Text="{Binding MyWeapon.Name}"
                                       FontSize="15" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="Cette action est irréversible."
                                   FontSize="12" Foreground="#555"
                                   TextWrapping="Wrap" TextAlignment="Center"/>

                        <!-- Boutons modernes -->
                        <Grid ColumnDefinitions="*,*" Margin="0,4,0,0">

                            <!-- Annuler -->
                            <Button Grid.Column="0" Command="{Binding CancelDeleteCommand}" Margin="0,0,6,0">
                                <Button.Template>
                                    <ControlTemplate>
                                        <Border Background="Transparent"
                                                CornerRadius="50"
                                                Padding="0,14"
                                                BorderBrush="#444"
                                                BorderThickness="1.5">
                                            <TextBlock Text="Annuler"
                                                       Foreground="#aaa"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Supprimer -->
                            <Button Grid.Column="1" Command="{Binding ConfirmDeleteCommand}" Margin="6,0,0,0">
                                <Button.Template>
                                    <ControlTemplate>
                                        <Border Background="#c0392b"
                                                CornerRadius="50"
                                                Padding="0,14">
                                            <TextBlock Text="🗑  Supprimer"
                                                       Foreground="White"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Message succès suppression -->
        <Border IsVisible="{Binding ShowDeleteSuccess}"
                Background="#CC000000"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Border Background="#141414"
                    CornerRadius="24"
                    BorderBrush="#2a2a2a"
                    BorderThickness="1"
                    MaxWidth="380"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <Border Background="#1a3a1a"
                            CornerRadius="24,24,0,0"
                            Padding="32,28">
                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                            <TextBlock Text="✅" FontSize="36" HorizontalAlignment="Center"/>
                            <TextBlock Text="Supprimée avec succès !"
                                       FontSize="17" FontWeight="Bold"
                                       Foreground="#2ecc71" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="28,20,28,28" Spacing="12">
                        <Border Background="#1e1e1e" CornerRadius="12" Padding="16,12"
                                BorderBrush="#333" BorderThickness="1">
                            <TextBlock Text="{Binding DeletedWeaponName}"
                                       FontSize="15" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="L'arme a été supprimée de votre collection."
                                   FontSize="12" Foreground="#555"
                                   TextAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

    </Grid>
</UserControl>
