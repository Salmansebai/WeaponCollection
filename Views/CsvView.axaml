<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WeaponCollection.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="WeaponCollection.Views.CsvView"
             x:DataType="vm:CsvViewModel">

    <Grid Background="#0f0f0f" RowDefinitions="Auto,*,Auto">

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="#161616"
                Padding="24,16"
                BorderBrush="#2a2a2a"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*">
                <Button Grid.Column="0" Command="{Binding BackCommand}">
                    <Button.Template>
                        <ControlTemplate>
                            <Border Background="#1a1a1a" CornerRadius="8" Padding="14,8"
                                    BorderBrush="#2a2a2a" BorderThickness="1">
                                <TextBlock Text="← Back" Foreground="#aaa" FontSize="13"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <TextBlock Grid.Column="1"
                           Text="Export / Import CSV"
                           FontSize="22" FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0"/>
            </Grid>
        </Border>

        <!-- CONTENU -->
        <ScrollViewer Grid.Row="1" Padding="30">
            <StackPanel Spacing="24" MaxWidth="700" HorizontalAlignment="Center">

                <!-- SECTION EXPORT -->
                <TextBlock Text="EXPORT" FontSize="10" Foreground="#555" LetterSpacing="2"/>
                <Border Background="#1a1a1a" CornerRadius="12" BorderBrush="#2a2a2a" BorderThickness="1">
                    <StackPanel Margin="20" Spacing="16">

                        <TextBlock Text="Sélectionnez les colonnes à exporter :"
                                   Foreground="#aaa" FontSize="13"/>

                        <ItemsControl ItemsSource="{Binding AvailableColumns}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ColumnSelection">
                                    <Border Background="#252525" CornerRadius="8" Padding="12,8" Margin="4">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <CheckBox IsChecked="{Binding IsSelected}"/>
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="White"
                                                       VerticalAlignment="Center"
                                                       FontSize="13"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Command="{Binding ExportCsvCommand}" HorizontalAlignment="Left">
                            <Button.Template>
                                <ControlTemplate>
                                    <Border Background="#1e3a5f" CornerRadius="8" Padding="20,10"
                                            BorderBrush="#2a5a8f" BorderThickness="1">
                                        <TextBlock Text="📄 Exporter en CSV"
                                                   Foreground="#3498db" FontWeight="Bold" FontSize="14"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                    </StackPanel>
                </Border>

                <!-- SECTION IMPORT -->
                <TextBlock Text="IMPORT" FontSize="10" Foreground="#555" LetterSpacing="2"/>
                <Border Background="#1a1a1a" CornerRadius="12" BorderBrush="#2a2a2a" BorderThickness="1">
                    <StackPanel Margin="20" Spacing="16">

                        <TextBlock Text="Importez des armes depuis un fichier CSV."
                                   Foreground="#aaa" FontSize="13"/>

                        <TextBlock Text="Le fichier CSV doit avoir les colonnes : Name, Type, Damage, Weight, Era, Country, Description, PictureUrl"
                                   Foreground="#555" FontSize="11" TextWrapping="Wrap"/>

                        <Button Command="{Binding ImportCsvCommand}" HorizontalAlignment="Left">
                            <Button.Template>
                                <ControlTemplate>
                                    <Border Background="#1a3a1a" CornerRadius="8" Padding="20,10"
                                            BorderBrush="#2a5a2a" BorderThickness="1">
                                        <TextBlock Text="📂 Importer depuis CSV"
                                                   Foreground="#2ecc71" FontWeight="Bold" FontSize="14"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Barre message en bas -->
        <Border Grid.Row="2"
                Background="#161616"
                Padding="24,14"
                BorderBrush="#2a2a2a"
                BorderThickness="0,1,0,0"
                IsVisible="{Binding ShowSuccess}">
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="#2ecc71"
                       FontSize="14"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>
        </Border>

    </Grid>
</UserControl>
