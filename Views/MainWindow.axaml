<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WeaponCollection.ViewModels"
        xmlns:views="using:WeaponCollection.Views"
        x:Class="WeaponCollection.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1200"
        Height="750"
        Background="#0f0f0f"
        Title="Weapon Collection">

    <DockPanel>

        <!-- HEADER -->
        <Border DockPanel.Dock="Top"
                Background="#0f0f0f"
                Padding="28,18"
                BorderBrush="#2a2a2a"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Background="#c0392b"
                            CornerRadius="8"
                            Width="36" Height="36">
                        <TextBlock Text="⚔"
                                   FontSize="18"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="White"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="WEAPON COLLECTION"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   LetterSpacing="3"/>
                        <TextBlock Text="Arsenal Manager"
                                   FontSize="11"
                                   Foreground="#666"
                                   LetterSpacing="1"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- PAGE CONTENT -->
        <ContentControl Content="{Binding CurrentPage}"/>

    </DockPanel>

</Window>
